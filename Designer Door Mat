n, m = map(int, input().strip().split())
output = []

for i in range(n // 2):
    pattern = ".|." * (2 * i + 1)
    output.append(pattern.center(m, "-"))

output.append("WELCOME".center(m, "-"))

for i in range(n // 2 - 1, -1, -1):
    pattern = ".|." * (2 * i + 1)
    output.append(pattern.center(m, "-"))

print("\n".join(output))
